# Copy to .env before the first `docker compose up`:   cp .env.example .env
# Every value here is a throwaway default for local development.
# Generate your own secrets before exposing this stack beyond localhost.

# ── PostgreSQL (Airflow metadata, OLTP source, Silver mirror, Gold warehouse) ─
# Superuser: used only by Postgres itself and the schema migrations
POSTGRES_USER=streamcart
POSTGRES_PASSWORD=streamcart
POSTGRES_DB=streamcart_db
# Application login used by Airflow, Spark, dbt, the simulator and the serving sink
POSTGRES_APP_USER=streamcart_app
POSTGRES_APP_PASSWORD=streamcart_app
# Superset's own metadata database (users, charts, dashboards), owned by this login
SUPERSET_DB_USER=streamcart_superset
SUPERSET_DB_PASSWORD=streamcart_superset
# Read-only login used by Grafana, Superset and the REST API
POSTGRES_READER_USER=streamcart_reader
POSTGRES_READER_PASSWORD=streamcart_reader

# ── MinIO (S3-compatible lakehouse storage) ───────────────────────────────────
MINIO_ROOT_USER=streamcart
MINIO_ROOT_PASSWORD=streamcart123
MINIO_BUCKET=streamcart-data
# The login Spark and Airflow use, limited to the lakehouse buckets (created by minio-init).
# The root login above is only for MinIO itself and its console.
MINIO_APP_USER=streamcart-lakehouse
MINIO_APP_PASSWORD=streamcart-lakehouse-secret

# ── Kafka: one login per service, each limited by ACLs to the topics it uses ─────
# admin is the only superuser, used by kafka-init to create topics and ACLs.
KAFKA_ADMIN_PASSWORD=streamcart-admin
KAFKA_PRODUCER_PASSWORD=streamcart-producer
KAFKA_SPARK_PASSWORD=streamcart-spark
KAFKA_SINK_PASSWORD=streamcart-sink
KAFKA_KSQL_PASSWORD=streamcart-ksql
KAFKA_REGISTRY_PASSWORD=streamcart-registry

# ── Airflow ───────────────────────────────────────────────────────────────────
# python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AIRFLOW__CORE__FERNET_KEY=LbKLC7ZJd4OAHy5JvBQgH15MJx2y7ZlswbIfnIUYsF8=
AIRFLOW__WEBSERVER__SECRET_KEY=563d6fbd55ef467d131a5cf075a1484371b36404d4a10663
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ── Alerts ────────────────────────────────────────────────────────────────────
# A Slack or Mattermost incoming webhook. Failed tasks and volume drops are posted here.
# Leave empty to only record them on the Pipeline Observability dashboard.
ALERT_WEBHOOK_URL=

# ── Grafana and Superset ───────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_SECRET_KEY=8a1f3c0e6b7d4925a1c84f0d7e326b95cf12ad4470be3961

# ── Host ports: change these if something else on your machine already uses them
POSTGRES_HOST_PORT=5432
AIRFLOW_HOST_PORT=8080
SPARK_UI_HOST_PORT=8081
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
SCHEMA_REGISTRY_HOST_PORT=8085
KSQLDB_HOST_PORT=8088
GRAFANA_HOST_PORT=3000
SUPERSET_HOST_PORT=8089
API_HOST_PORT=8000

# ── What to run: full, or a comma-separated mix of realtime, batch and bi ──────
# Kafka, Schema Registry, Postgres and the simulator always run.
COMPOSE_PROFILES=full
