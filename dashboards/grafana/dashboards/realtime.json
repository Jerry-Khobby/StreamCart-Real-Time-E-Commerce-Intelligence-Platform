{
  "uid": "streamcart-realtime",
  "title": "StreamCart: Real-Time Operations",
  "description": "Live view of the Kafka and ksqlDB layer.",
  "tags": [
    "streamcart",
    "real-time"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Orders (last 5 min)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "streamcart-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "streamcart-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM realtime.transactions WHERE event_time > now() - interval '5 minutes'",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Revenue, USD (last hour)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "streamcart-postgres"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "streamcart-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(amount_usd), 0) AS value FROM realtime.transactions WHERE status = 'completed' AND event_time > now() - interval '1 hour'",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Fraud alerts (last hour)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "streamcart-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "streamcart-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM realtime.fraud_alerts WHERE event_time > now() - interval '1 hour'",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "SKU locations below reorder point",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "streamcart-postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "streamcart-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS value FROM realtime.stock_levels WHERE stock < reorder_point",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 250
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Live transactions by region (per minute)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "streamcart-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "streamcart-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_bin('1 minute', event_time, TIMESTAMPTZ 'epoch') AS time, region AS metric, count(*) AS value FROM realtime.transactions WHERE $__timeFilter(event_time) GROUP BY 1, 2 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Fraud alerts by signal (per 5 min)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "streamcart-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "streamcart-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_bin('5 minutes', event_time, TIMESTAMPTZ 'epoch') AS time, fraud_signal AS metric, count(*) AS value FROM realtime.fraud_alerts WHERE $__timeFilter(event_time) GROUP BY 1, 2 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Fraud alerts feed",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "streamcart-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "streamcart-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT event_time, fraud_signal, region, user_id, round(amount_usd::numeric, 2) AS amount_usd, transaction_id FROM realtime.fraud_alerts ORDER BY event_time DESC LIMIT 100",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fraud_signal"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "HIGH_VALUE_NEW_SESSION": {
                        "color": "red",
                        "index": 0
                      },
                      "VELOCITY_BREACH": {
                        "color": "orange",
                        "index": 1
                      },
                      "GEO_ANOMALY": {
                        "color": "yellow",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "amount_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "Newest first, from the ksqlDB fraud_alerts topic."
    },
    {
      "id": 8,
      "title": "Inventory risk heatmap: restock alerts per warehouse",
      "type": "heatmap",
      "datasource": {
        "type": "postgres",
        "uid": "streamcart-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "streamcart-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_bin('10 minutes', event_time, TIMESTAMPTZ 'epoch') AS time, warehouse_id AS metric, count(*)::float AS value FROM realtime.restock_events WHERE $__timeFilter(event_time) GROUP BY 1, 2 ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "scale": "exponential",
          "exponent": 0.5,
          "steps": 64,
          "fill": "dark-orange",
          "reverse": false
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "cellValues": {
          "unit": "short"
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": false,
          "showColorScale": false
        },
        "legend": {
          "show": true
        },
        "exemplars": {
          "color": "orange"
        },
        "filterValues": {
          "le": 1e-09
        }
      },
      "description": "Darker cells mean more low-stock alerts from that warehouse in that 10-minute window."
    },
    {
      "id": 9,
      "title": "Pipeline lag: unconsumed messages by topic",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "streamcart-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "streamcart-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT sampled_at AS time, topic AS metric, consumer_lag AS value FROM realtime.pipeline_lag WHERE $__timeFilter(sampled_at) ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Pipeline latency: event time to dashboard",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "streamcart-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "streamcart-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT sampled_at AS time, topic AS metric, latency_ms AS value FROM realtime.pipeline_lag WHERE $__timeFilter(sampled_at) AND latency_ms IS NOT NULL ORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "Fraud rule accuracy (last 24 hours)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "streamcart-postgres"
      },
      "description": "Scored against the simulator's hidden labels. Some fraud is built to evade the rules and some innocent orders look suspicious, so neither figure should be 100%.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "streamcart-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT fraud_signal, true_positives AS caught, false_positives AS false_alarms, false_negatives AS missed, precision_pct, recall_pct FROM observability.fraud_evaluation WHERE evaluated_at = (SELECT max(evaluated_at) FROM observability.fraud_evaluation) ORDER BY fraud_signal"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "precision_pct|recall_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
  ]
}
